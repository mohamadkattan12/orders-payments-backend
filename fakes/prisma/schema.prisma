// State of the fake external systems (FakePay, ERP, Courier, e-invoicing portal).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Pinned: the Docker build generates before tsconfig.json is copied, and Prisma would infer ".ts".
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
