# Every value below is a DEV-ONLY default, already built into the code so `docker compose up`
# works with no setup. Override them anywhere real; never reuse these values.
ADMIN_KEY=dev-admin-key
FAKES_CONTROL_KEY=dev-control-key
FAKEPAY_WEBHOOK_SECRET=dev-fakepay-secret
ERP_WEBHOOK_SECRET=dev-erp-secret
COURIER_WEBHOOK_SECRET=dev-courier-secret
# Per-IP requests per 10 s on public routes; raise it for the load test only.
THROTTLE_LIMIT=200
